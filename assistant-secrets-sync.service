[Unit]
Description=Sync assistant-backend secrets from Bitwarden
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
# Encrypted at rest, decrypted by systemd only into this unit's private
# $CREDENTIALS_DIRECTORY for the run's duration — never plaintext on disk.
# Create the source file once with:
#   echo -n 'your master password' | systemd-creds encrypt - /root/.bw-master-password.cred
LoadCredentialEncrypted=BW_MASTER_PASSWORD:/root/.bw-master-password.cred
ExecStart=/usr/bin/bash /opt/assistant-backend/scripts/sync_secrets_from_bitwarden.sh
