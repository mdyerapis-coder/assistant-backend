# Copy to assistant.env and fill in — or let scripts/sync_secrets_from_bitwarden.sh
# populate assistant.env from Bitwarden instead (see docs/adr/011).
# O1 Google OAuth relay operator notes: docs/oauth-relay.md
# Never put GOOGLE_CLIENT_SECRET_JSON or GOOGLE_TOKEN_ENCRYPTION_KEY in the APK.

ASSISTANT_BEARER_TOKEN=
OPENAI_API_KEY=
# Optional — leave unset for api.openai.com directly. Currently set to
# Cline's gateway (https://api.cline.bot/api/v1) in production, an
# OpenAI-Chat-Completions-compatible endpoint fronting multiple providers
# behind one key with namespaced model ids.
OPENAI_BASE_URL=
GOOGLE_CLIENT_SECRET_JSON=
ASSISTANT_DB_PATH=assistant.db

# O1 relay (defaults are production-safe if omitted):
# ASSISTANT_PUBLIC_URL=https://assistant.llmclouds.au
# GOOGLE_OAUTH_REDIRECT_URI=https://assistant.llmclouds.au/oauth/google/callback
# GOOGLE_OAUTH_DEEPLINK=sableapp://oauth-complete
# Prefer the file /opt/assistant-backend/.google-token-key over this env var
# so Bitwarden rewrites cannot drop the Fernet key:
# GOOGLE_TOKEN_ENCRYPTION_KEY=
