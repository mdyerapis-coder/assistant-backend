[Unit]
Description=Uptime + journal error alerting for assistant.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=-/opt/assistant-backend/assistant.env
EnvironmentFile=-/etc/default/assistant-health-alert
ExecStart=/usr/bin/bash /opt/assistant-backend/scripts/health_alert.sh
