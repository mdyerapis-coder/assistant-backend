[Unit]
Description=assistant-backend (personal assistant API) — placeholder name
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/assistant-backend
EnvironmentFile=/opt/assistant-backend/assistant.env
ExecStart=/opt/assistant-backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8090
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
